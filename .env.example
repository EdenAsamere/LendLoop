# -----------------------------------------------------------------------------
# LendLoop Environment Configuration
# -----------------------------------------------------------------------------

# --- Convex Database & Backend ---
# Public URL for the Convex deployment (provided by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL="https://your-convex-deployment.convex.cloud"
CONVEX_DEPLOYMENT="dev:your-deployment-name"
CONVEX_SITE_URL="https://your-convex-deployment.convex.site"

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# The Issuer URL from your Clerk JWT template configured for Convex:
CLERK_JWT_ISSUER_DOMAIN="https://your-clerk-domain.clerk.accounts.dev"

# --- n8n Workflow Automation & Security ---
# n8n Webhook endpoint triggered by Convex when borrow requests change status
N8N_WEBHOOK_URL="http://localhost:5678/webhook/lendloop-requests"

# Shared HMAC secret for cryptographically signing webhook payloads
# Must match the secret configured in n8n's "Verify HMAC & Replay" node
N8N_WEBHOOK_SECRET="lendloop-secret-key-32chars-minimum!"

# Secret API bearer token for n8n -> Convex HTTP Actions (/api/overdue-loans, /api/overdue-reminders/record)
N8N_API_KEY="lendloop-n8n-secret-api-key-2026"

